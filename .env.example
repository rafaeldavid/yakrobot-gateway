# MCP server auth (optional — leave empty to disable auth)
# Single shared token (legacy/dev): all callers share one identity ("default").
MCP_BEARER_TOKEN=
# Per-agent tokens (Tier 1): give each agent its own token so the gateway can tell
# callers apart — required for robot reservations to distinguish who's in control.
# Format: client_id=token pairs, comma-separated, e.g. marketplace=tok_abc,teleop=tok_def
MCP_TOKENS=
# Hot-reloading token FILE (recommended once deployed): add/revoke agents by editing the
# file — no restart. Takes precedence over MCP_TOKENS/MCP_BEARER_TOKEN when set.
# File format: one `client_id=token` per line, `#` comments allowed. See mcp-tokens.example.txt
MCP_TOKENS_FILE=

# Public tunnel provider: ngrok (default) or cloudflare. `serve.py --tunnel` overrides.
TUNNEL_PROVIDER=

# ngrok (free static domain from https://dashboard.ngrok.com/domains)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Cloudflare Tunnel — alternative to ngrok. Needs the `cloudflared` binary on PATH:
# https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# Stable named tunnel: token from the dashboard (Zero Trust > Networks > Tunnels); its
# ingress must point at http://localhost:<port>. CLOUDFLARE_DOMAIN is the hostname you
# mapped, used only to print the public URL. Leave BOTH empty for an ephemeral
# *.trycloudflare.com quick tunnel (no account needed).
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_DOMAIN=

# On-chain registration/discovery/attestation is NOT handled by this repo.
# It lives in the sibling yakrobot-identity package — configure those secrets
# (SIGNER_PVT_KEY, PINATA_JWT, RPC_URL, ...) in yakrobot-identity's own .env.

# Robot addresses (optional — override to point at your own hardware)
# Tumbller: HTTP base URL of your rover (default: http://finland-tumbller-01.local)
TUMBLLER_URL=
# Tello: drone IP (default: the Tello's built-in IP)
TELLO_HOST=
# PiCar (Freenove 4WD): HTTP base URL of the control server on the car's Pi
# (default: http://picar-freenove.local:8080). Use the Pi's IP if mDNS is flaky.
PICAR_FREENOVE_URL=
# Only if the car itself runs with ROBOT_TOKEN set. Leave empty when the robot has
# its own auth disabled — this is the car's token, not the gateway's (MCP_TOKENS).
PICAR_FREENOVE_TOKEN=

# Fake robot simulator (optional — defaults to http://localhost:8080)
FAKEROBOT_URL=http://localhost:8080

# Task auctions live in the separate yakrobot-marketplace service. Card-paid teleop is
# gated here, against the operator's own Stripe account — see the block below.
FAKEROBOT_PICAR_URL=http://127.0.0.1:8081

# Set to 0 to refuse /ws/video for every client (saves a metered link).
# Control still works; the car stays drivable, just blind.
VIDEO_ENABLED=1

# Teleop admission is always gated one of two ways — paid or free — never neither.
# Paid means x402 (PAYMENTS_ENABLED=1), card (STRIPE_GATE_ENABLED=1), or both. Free
# reservations are on only when neither gate is set — no separate variable for that:
# /{robot}/lease/reserve grants an unpaid, timed, exclusive turn with no payment and no
# signature. See AGENTS.md and plans/paid-teleop-execution.md §0.1 in the pi-drg
# planning repo for the full rules.
PAYMENTS_ENABLED=0
# Base URL of the yakrobot-payments service selling leases for this gateway, e.g.
# https://pay.yakrobot.com. Required when PAYMENTS_ENABLED=1.
PAYMENTS_URL=
# Lowercase 0x address of the yakrobot-payments issuer key — capabilities are verified
# by recovering their signer and comparing to this address. Required when
# PAYMENTS_ENABLED=1.
PAYMENTS_ISSUER=
# Decimal USD string, at most 6 decimal places, > 0. Paid teleop only.
TELEOP_PRICE_USDC=1.00
# Integer 1-60 — the lease length, in every mode. Validated at startup regardless of
# PAYMENTS_ENABLED, since free reservations need it whenever no paid gate is on.
TELEOP_LEASE_MINUTES=5

# Per-operator Stripe card gate (off by default). Set STRIPE_GATE_ENABLED=1 to enable;
# free teleop is off whenever this or PAYMENTS_ENABLED is on. Needs `uv sync --extra stripe`.
# STRIPE_GATE_ENABLED=0
# sk_... or restricted rk_... key (test or live). The card-lease credential's HMAC key is
# derived from it, so rotating the key logs out active drivers. Prefer a restricted rk_
# key plus Stripe's IP allowlist — a leaked live key can create charges and refunds.
# STRIPE_SECRET_KEY=
# Card price in cents, integer >= 50 (Stripe's USD minimum).
# STRIPE_PRICE_CENTS=100
# 3-letter currency code (default usd).
# STRIPE_CURRENCY=usd
# Stripe API base (default https://api.stripe.com; point at the fake for local dev).
# STRIPE_API_BASE=
